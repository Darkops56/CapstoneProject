      "parameters": {
        "jsCode": "// @ts-nocheck\n// Circuit Breaker & Idempotence Check\nconst inputJson = $input.first().json;\nconst runData = inputJson['data'] || {};\nconst datasetId = runData['defaultDatasetId'];\nconst runStatus = runData['status'] || '';\n\n// En cuentas gratuitas de Apify chargedEventCounts puede venir en 0 porque no se cobra por item.\n// Verificamos que el scraper haya finalizado en SUCCEEDED y que exista el datasetId.\nconst charged = runData['chargedEventCounts'] || runData['accountedChargedEventCounts'] || {};\nconst chargedCount = Number(charged['apify-default-dataset-item'] || 0);\nconst isBatchValid = (runStatus === 'SUCCEEDED' && Boolean(datasetId));\n\nif (!isBatchValid) {\n  return [{\n    json: {\n      proceed: false,\n      reason: 'ERR_SCRAPER_INCOMPLETE_BATCH',\n      message: `Scraper finalizó con estado '${runStatus}' sin dataset válido. Abortando para proteger datos.`\n    }\n  }];\n}\n\n// Idempotencia contra $getWorkflowStaticData()\nconst staticData = $getWorkflowStaticData('global');\nconst prevDatasetId = staticData.lastDatasetId;\n\nif (prevDatasetId && prevDatasetId === datasetId) {\n  return [{\n    json: {\n      proceed: false,\n      reason: 'SKIP_IDENTICAL_DATASET',\n      message: 'Dataset idéntico al procesado previamente. Sin cambios.'\n    }\n  }];\n}\n\nstaticData.lastDatasetId = datasetId;\n\nreturn [{\n  json: {\n    proceed: true,\n    datasetId: datasetId,\n    itemCount: chargedCount > 0 ? chargedCount : 5\n  }\n}];"
      },
