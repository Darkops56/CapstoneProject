      "parameters": {
        "jsCode": "// @ts-nocheck\n// Retención Trimestral: Conservar únicamente datasets de los últimos 3 meses (o máximo 3 archivos)\nconst items = $input.all();\nif (!items || items.length === 0) {\n  return [];\n}\n\nconst KEEP_MONTHS = 3;\n\n// Helper: Extrae timestamp del nombre del archivo (YYYY_MM) o fallback a createdTime\nfunction getFileTimestamp(item) {\n  const name = item.json.name || '';\n  const match = name.match(/(\\d{4})_(\\d{2})/);\n  if (match) {\n    const year = parseInt(match[1], 10);\n    const month = parseInt(match[2], 10) - 1;\n    return new Date(Date.UTC(year, month, 1)).getTime();\n  }\n  return new Date(item.json.createdTime || item.json.modifiedTime || 0).getTime();\n}\n\n// Ordenar de más reciente a más antiguo\nitems.sort((a, b) => getFileTimestamp(b) - getFileTimestamp(a));\n\n// Umbral: primer día del mes hace 3 meses respecto a la fecha actual\nconst now = new Date();\nconst cutoffDate = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - (KEEP_MONTHS - 1), 1)).getTime();\n\nconst toDelete = [];\nitems.forEach((item, index) => {\n  const fileTime = getFileTimestamp(item);\n  const isOlderThan3Months = fileTime < cutoffDate;\n  const isBeyondCount = index >= KEEP_MONTHS;\n\n  if (isOlderThan3Months || isBeyondCount) {\n    toDelete.push({\n      json: {\n        fileId: item.json.id,\n        name: item.json.name,\n        reason: isOlderThan3Months ? 'OLDER_THAN_3_MONTHS' : 'EXCEEDS_MAX_COUNT_3',\n        fileDate: new Date(fileTime).toISOString().slice(0, 7),\n        totalEvaluated: items.length\n      }\n    });\n  }\n});\n\nreturn toDelete;"
      },
