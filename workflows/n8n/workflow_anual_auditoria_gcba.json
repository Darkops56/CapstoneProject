      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst csvTexts = [];\nfor (let i = 0; i < items.length; i++) {\n  const buf = await this.helpers.getBinaryDataBuffer(i, \"data\");\n  if (buf && buf.length > 0) {\n    csvTexts.push(buf.toString(\"utf8\"));\n  }\n}\nif (csvTexts.length === 0) {\n  throw new Error(\"ERR_NO_TRAINING_CSV_IN_DRIVE: No se encontraron archivos CSV en Drive para entrenar.\");\n}\nreturn [{\n  json: {\n    minR2Threshold: 0.80,\n    minSamples: 500,\n    trainingDataCsvText: csvTexts\n  }\n}];"
      },
