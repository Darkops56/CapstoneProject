    {
      "parameters": {
        "jsCode": "const catalog = $(\"Definir Catálogo Datasets GCBA\").all();\nconst responses = $input.all();\nconst staticData = $getWorkflowStaticData(\"global\");\nstaticData.lastModifiedByDataset = staticData.lastModifiedByDataset || {};\n\nreturn responses.map((item, idx) => {\n  const meta = catalog[idx]?.json || { datasetId: \"unknown\", filePrefix: \"gcba_anual\" };\n  const raw = item.json || {};\n  if (raw.error || !raw.result) {\n    return {\n      json: {\n        datasetId: meta.datasetId,\n        filePrefix: meta.filePrefix,\n        datasetTitle: meta.datasetId,\n        metadataModified: \"\",\n        lastModified: staticData.lastModifiedByDataset[meta.datasetId] || \"\",\n        hasUpdate: false,\n        downloadUrl: \"\",\n        resourceFormat: \"csv\",\n        resourceName: `${meta.datasetId}_unavailable`,\n        gcbaStatus: \"WARN_GCBA_UNAVAILABLE\",\n        eventToken: \"WARN_GCBA_UNAVAILABLE\"\n      }\n    };\n  }\n  const result = raw.result;\n  const metadataModified = result.metadata_modified || \"\";\n  const resources = result.resources || [];\n  const lastModified = staticData.lastModifiedByDataset[meta.datasetId] || \"\";\n  const hasUpdate = Boolean(metadataModified && metadataModified !== lastModified);\n  const latestResource = resources.find(r => r.format?.toLowerCase() === \"csv\" || r.format?.toLowerCase() === \"xlsx\") || resources[0];\n  if (hasUpdate) {\n    staticData.lastModifiedByDataset[meta.datasetId] = metadataModified;\n  }\n  return {\n    json: {\n      datasetId: meta.datasetId,\n      filePrefix: meta.filePrefix,\n      datasetTitle: result.title || meta.datasetId,\n      metadataModified,\n      lastModified,\n      hasUpdate,\n      downloadUrl: latestResource?.url || \"\",\n      resourceFormat: latestResource?.format || \"csv\",\n      resourceName: latestResource?.name || `${meta.datasetId}_actualizado`,\n      gcbaStatus: hasUpdate ? \"EVENT_GCBA_DATA_UPDATED\" : \"SKIP_NO_ANNUAL_UPDATE\",\n      eventToken: hasUpdate ? \"EVENT_GCBA_DATA_UPDATED\" : \"SKIP_NO_ANNUAL_UPDATE\"\n    }\n  };\n});"
      },
