    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json.result || {};\nconst metadataModified = result.metadata_modified || '';\nconst resources = result.resources || [];\n\n// Idempotencia contra $getWorkflowStaticData()\nconst staticData = $getWorkflowStaticData('global');\nconst lastModified = staticData.lastModified || '';\n\nconst hasUpdate = Boolean(metadataModified && metadataModified !== lastModified);\n\n// Filtrar último archivo CSV o XLSX publicado\nconst latestResource = resources.find(r => r.format?.toLowerCase() === 'csv' || r.format?.toLowerCase() === 'xlsx') || resources[0];\n\nif (hasUpdate) {\n  staticData.lastModified = metadataModified;\n}\n\nreturn [{\n  json: {\n    datasetTitle: result.title,\n    metadataModified: metadataModified,\n    lastModified: lastModified,\n    hasUpdate: hasUpdate,\n    downloadUrl: latestResource?.url || '',\n    resourceFormat: latestResource?.format || 'csv',\n    resourceName: latestResource?.name || 'delitos_actualizado',\n    eventToken: hasUpdate ? 'EVENT_GCBA_DATA_UPDATED' : 'SKIP_NO_ANNUAL_UPDATE'\n  }\n}];"
      },
      "id": "0856f7f0-e7f3-401f-8519-1d332e4247a4",
      "name": "Evaluar Metadatos & URL Descarga",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
