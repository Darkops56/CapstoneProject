      "parameters": {
        "jsCode": "const runResp = $(\"Apify: Actor Trainer\").first().json || {};\nconst runData = runResp.data || runResp;\nconst status = runData.status || \"UNKNOWN\";\nconst kvStoreId = runData.defaultKeyValueStoreId;\nconst prodStoreResp = $(\"Apify: Abrir Store Producción\").first().json || {};\nconst prodStoreId = (prodStoreResp.data && prodStoreResp.data.id) || \"mlops-production-models\";\nif (status !== \"SUCCEEDED\" || !kvStoreId) {\n  throw new Error(`ERR_TRAINER_RUN_FAILED: status=${status}, kvStoreId=${kvStoreId}`);\n}\nconst files = [\n  \"kmeans_model.joblib\",\n  \"xgb_price_model.joblib\",\n  \"model_metadata.joblib\",\n  \"models_manifest.json\"\n];\nreturn files.map(fileName => ({\n  json: {\n    kvStoreId,\n    prodStoreId,\n    fileName,\n    downloadUrl: `https://api.apify.com/v2/key-value-stores/${kvStoreId}/records/${fileName}`\n  }\n}));"
