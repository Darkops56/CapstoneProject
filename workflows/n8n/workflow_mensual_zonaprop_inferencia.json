      "parameters": {
        "jsCode": "// @ts-nocheck\n// Retención Trimestral: Conservar únicamente los 3 datasets más recientes en 01_mensual_enriquecido\nconst KEEP_COUNT = 3;\nconst items = $input.all();\n\n// Ordenar por fecha de creación descendente (los más nuevos primero)\nitems.sort((a, b) => {\n  const dateA = new Date(a.json.createdTime || a.json.modifiedTime || 0).getTime();\n  const dateB = new Date(b.json.createdTime || b.json.modifiedTime || 0).getTime();\n  return dateB - dateA;\n});\n\n// Protección contra sobre-borrado: si no supera el límite, no purgar nada\nif (items.length <= KEEP_COUNT) {\n  return [];\n}\n\n// Los excedentes (> 3) se envían a la papelera\nconst toDelete = items.slice(KEEP_COUNT);\nreturn toDelete.map(item => ({\n  json: {\n    fileId: item.json.id,\n    name: item.json.name,\n    reason: 'RETENTION_TRIMESTRAL_PURGE',\n    totalBefore: items.length,\n    keptCount: KEEP_COUNT\n  }\n}));"
      },
